# Variables read by compose.prod.yml. Copy this file to .env.

# Password of the postgres user, used by both the api and db services.
# It goes into a key=value DSN: avoid spaces, quotes and backslashes.
POSTGRES_PASSWORD=

# Base64 encoded 32 byte key that checks PASETO tokens.
# Generate one with: open-catalog-api token create
# Leave it empty to run the API in read only mode.
PASETO_KEY=

# Maximum requests per minute from each client IP. 0 disables the limit.
MAX_REQUESTS=0

# Comma separated addresses or CIDRs of the reverse proxies in front of
# the API. Only these may set X-Forwarded-For.
TRUSTED_PROXIES=
